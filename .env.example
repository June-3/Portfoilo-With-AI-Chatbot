# ============================================================
# Environment Variables Example: Copy this file to .env.local and fill in real values.
# Note: .env.local is ignored by .gitignore and should not be committed to the repository.
# ============================================================

# ---------- AI Assistant (DeepSeek, Milestone 3) ----------
# Required: DeepSeek API Key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional, defaults shown below
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Daily token limit for anonymous visitors (default 2000)
DAILY_TOKEN_LIMIT=10000
# Daily token limit for logged-in users (default 10000)
LOGGED_IN_DAILY_LIMIT=50000
# RAG retrieval thresholds (can be changed in /admin → Settings; these are environment defaults)
# Strong match score threshold for personal knowledge base (higher = stricter, default 2)
KB_STRONG_SCORE=2
# Code vector similarity threshold (0–1, lower = more permissive, default 0.25)
CODE_SCORE_THRESHOLD=0.25
# Max tokens per AI reply (default 1500; higher = less truncation but more tokens consumed)
MAX_REPLY_TOKENS=1500

# ---------- Owner Admin ----------
# Admin panel password (development default admin123; change in production)
ADMIN_PASSWORD=

# ---------- Email / SMTP (Milestone 4) ----------
# SMTP configuration for the owner's public email account
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address (optional, defaults to SMTP_USER)
SMTP_FROM=
# Email address where the owner receives notification emails
OWNER_EMAIL=

# ---------- Site ----------
# Full site URL (used for sitemap / robots; set to production domain)
NEXT_PUBLIC_SITE_URL=

# ---------- Encryption ----------
# Used to encrypt stored emails / conversation records (recommended 32+ random characters)
ENCRYPTION_KEY=

# ---------- Database / Storage (Supabase) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only (pgvector insert/search); NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ---------- RAG / pgvector (Code knowledge base, Jina Embeddings) ----------
# Required: Jina API Key from https://jina.ai
JINA_API_KEY=
# Optional, defaults shown below
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_EMBED_DIM=1024

# ---------- Redis (Milestone 4, verification codes / rate limiting / blacklist) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=