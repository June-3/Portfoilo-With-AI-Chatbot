# ============================================================
# 环境变量示例：复制本文件为 .env.local 并填入真实值。
# 注意：.env.local 已被 .gitignore 忽略，不要提交到仓库。
# ============================================================

# ---------- AI 助手（DeepSeek，里程碑 3） ----------
# 必填：DeepSeek 平台申请的 API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
# 可选，默认如下
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 匿名访客每日 token 限额（默认 2000）
DAILY_TOKEN_LIMIT=2000
# 登录用户每日 token 限额（默认 10000）
LOGGED_IN_DAILY_LIMIT=10000

# ---------- 站长后台 ----------
# 后台管理密码（开发默认 admin123，生产务必修改）
ADMIN_PASSWORD=

# ---------- 邮箱 / SMTP（里程碑 4） ----------
# 站长个人公共邮箱的 SMTP 配置
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人地址（可选，默认同 SMTP_USER）
SMTP_FROM=
# 站长接收通知邮件的邮箱
OWNER_EMAIL=

# ---------- 站点 ----------
# 站点完整 URL（用于 sitemap / robots，生产填正式域名）
NEXT_PUBLIC_SITE_URL=

# ---------- 加密 ----------
# 用于加密存储邮箱 / 对话记录（建议 32+ 位随机字符串）
ENCRYPTION_KEY=

# ---------- 数据库 / 存储（里程碑 4） ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Redis（里程碑 4，验证码 / 限流 / 黑名单） ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
